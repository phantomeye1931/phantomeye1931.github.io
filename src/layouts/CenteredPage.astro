---
import Page, {type Props as PageProps} from "./Page.astro";

export interface Props extends PageProps {}

let props = Astro.props;

props.opts.extraButtons = [
    { alignRight: false, url: "/", label: "HOME" }
];
---

<Page opts={ props.opts } description={ props.description } title={ props.title }>
    <div class="wrapper">
        <slot/>
    </div>
</Page>

<style>
.wrapper {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;

    min-height: 100svh;
    width: 100%;
    height: 100%;
    margin-inline: auto;
}
</style>
