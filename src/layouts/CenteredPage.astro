---
import { undefined } from "astro/zod";
import Page, {type PageProps} from "./Page.astro";
import type {NavButtonOpts} from "../components/HeaderButtons.astro";

type Props = PageProps;

let props = Astro.props as Props;

const extraButtons = [
    {alignRight: false, url: "/", label: "HOME"}
]
---

<Page title={ props.title } description={ props.description } background={{ sticky: false }} navButtons={{ extraButtons } } >
    <div class="wrapper">
        <slot/>
    </div>
</Page>

<style>
.wrapper {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;

    min-height: 100svh;
    width: 100%;
    height: 100%;
    margin-inline: auto;
}
</style>
