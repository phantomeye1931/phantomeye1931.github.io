---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ShapePaperClip from '../components/shapes/ShapePaperClip.astro';
import {getPageStyle} from "../utils/random_blog_style.ts";
import Page from "./Page.astro";
import type {Button} from "../utils/types.ts";
import DoodleComment from "../components/items/DoodleComment.astro";
import BusinessCard from '../components/items/BusinessCard.astro';

type Props = CollectionEntry<'blog'>['data'];

interface LocalProps {
	title: string,
	description: string,
	pubDate: Date,
	updatedDate?: Date,
}

const props = Astro.props as LocalProps;

const headerButtons: Button[] = [
	{ alignRight: false, url: "/", label: "HOME" },
	{ alignRight: true, label: "BACK TO TOP", url: "#"}
];
---

<Page title={props.title} description={props.description} opts={{ background: true, buttons: true, extraButtons: headerButtons, bgSticky: true }}>
	<article>
		<div class="paper" style={ getPageStyle(props.description) }>
			<ShapePaperClip class="paperclip"/>
			<div class="header">
				<a href="/#weblog" class="back-link">[x] Close</a>
				<div class="top">
					<div class="title">{ props.title }</div>
					<div class="date">
						<span>Posted:</span>  <FormattedDate date={ props.pubDate } /> <br>
						{ props.updatedDate ? (<span>Updated:</span> <FormattedDate date={ props.updatedDate } />) : '' }
					</div>
				</div>
				<div class="description">{ props.description }</div>
			</div>

			<slot />

			<div class="business-card">
				<div class="comment">
					<DoodleComment x={200} y={-60} textX={-180} textY={-95}>Click to flip!</DoodleComment>
				</div>
				<BusinessCard />
			</div>
		</div>
	</article>
</Page>

<style>
.business-card {
	position: relative;
	display: flex;
	justify-content: flex-end;
	margin-top: 8rem;
}

.comment {
	display: contents;
}

@media (max-width: 800px) {
	.business-card {
		justify-content: center;
	}

	.comment {
		display: none;
	}
}
</style>