---
import BaseHead from "../components/BaseHead.astro";

import HalftoneBackground, {type BackgroundOpts} from "../components/HalftoneBackground.astro";
import HeaderButtons, {type NavButtonOpts} from "../components/HeaderButtons.astro";

type Props = {
    title: string,
    description: string,

    navButtons?: NavButtonOpts
    background?: BackgroundOpts
};

export type PageProps = Props;

const props = Astro.props as Props;
---

<!doctype html>
<html lang="en">
    <head>
        <title>{props.title}</title>
        <BaseHead title={props.title} description={props.description} />
    </head>
    <body>
        <main>
            <div class="page-wrapper">
                { props.background ? (
                        <HalftoneBackground
                                variant={ props.background.variant }
                                sticky ={ props.background.sticky ?? false } />
                ) : '' }
                <div class="page-contents">
                    { props.navButtons ?
                            <HeaderButtons
                                    extraButtons  ={ props.navButtons.extraButtons   ?? [] }
                                    dockingButtons={ props.navButtons.dockingButtons }
                                    mobileCentered={ props.navButtons.mobileCentered ?? false }/>
                    : '' }
                    <slot />
                </div>
            </div>

            <div class="overlay"></div>
        </main>
    </body>
</html>

<style>
html {
    scroll-behavior: smooth;
    background-color: var(--col-background-dark);


    & :global(*) {
        transition: border var(--theme-transition), color var(--theme-transition), background-color var(--theme-transition);
    }
}

.overlay {
    position: fixed;
    inset: 0;
    background: var(--col-background);
    z-index: 1000;

    pointer-events: none;
    opacity: 0;

    transition: opacity 0.5s var(--bezier-transition);

    &[active] {
        opacity: 50%;
        pointer-events: auto;
    }
}

.page-wrapper {
    background-color: var(--col-background);




    position: absolute;
    min-height: 100svh;
    width: 100%;

    &:after {
        content: "";
        z-index: 1000;
        inset: 0;
        position: absolute;

        background-image: url("/svg/grain.svg");
        background-size: 400px 400px;
        pointer-events: none;

        mix-blend-mode: multiply;
        opacity: 0.5;
    }
}

.page-contents {
    position: relative;
    z-index: 1;
    color: var(--col-text-1);
}

</style>
