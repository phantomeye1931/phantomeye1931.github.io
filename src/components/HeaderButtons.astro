---
import type {Button} from "../utils/types.ts";

interface Props {
    defaultButtons?: boolean,
    extraButtons: Button[],
    mobileCentered?: boolean,
    dockingButtons?: boolean,
}

export type NavButtonOpts = Props;

const props = Astro.props;

const buttons: Button[] = [];

function isExternal(url: string) {
    try {
        return new URL(url, Astro.url).hostname !== Astro.url.hostname;
    } catch {
        return false;
    }
}

if (props.defaultButtons ?? true) buttons.push(
    { alignRight: true, label: "", behavior: "toggle-dark-mode"},
)

buttons.push( ...props.extraButtons );

import codeIcon from '/svg/icons/code.svg?raw';

if (props.defaultButtons ?? true) buttons.push(
    { alignRight: true, label: codeIcon, url: "https://github.com/phantomeye1931/phantomeye1931.github.io"},
)

const leftButtons = buttons.filter(button => !button.alignRight);
const rightButtons = buttons.filter(button => button.alignRight);

const showLeft = leftButtons.length > 0;
const showRight = rightButtons.length > 0;
---

<div class="nav-bar" mobile-centered={ props.mobileCentered ?? false }>
    { showLeft ? <div class=`buttons left ${props.dockingButtons ? '' : 'floating'}`>
        { leftButtons.map((button) => (
                <a href={button.url} class=`link font-mono ${button.behavior ?? "javascript:void(0)"}` target={isExternal(button.url) ? "_blank" : undefined} >
                    <!-- [ + The actual link label, allows HTML + ] -->
                    <span class="bk">[</span><Fragment set:html={button.label} /><span class="bk">]</span>
                </a>
        ))}
    </div> : ''}
    { showRight ? <div class=`buttons right ${props.dockingButtons ? '' : 'floating'}`>
        { rightButtons.map((button) =>
                <a href={button.url} class=`link font-mono ${button.behavior ?? "javascript:void(0)"}` target={isExternal(button.url) ? "_blank" : undefined} >
                    <!-- [ + The actual link label, allows HTML + ] -->
                    <span class="bk">[</span><Fragment set:html={button.label} /><span class="bk">]</span>
                </a>
        )}
    </div> : ''}
</div>

<script>
    import { cycleColorSchemes, getDisplayedTheme, Theme } from "../scripts/theme";

    import moonIcon from '/svg/icons/moon.svg?raw';
    import sunIcon from '/svg/icons/sun.svg?raw';

    const $buttonsDiv = $(".buttons, .nav-bar");

    window.addEventListener("scroll", () => {
        $buttonsDiv.toggleClass("is-scrolled", window.scrollY > 0);
    });

    // Function to update the label text
    function updateThemeButton($el: JQuery, mode: Theme) {
        let text: string;
        switch (mode) {
            case Theme.DARK: text = `${sunIcon}`; break;
            case Theme.LIGHT: text = `${moonIcon}`; break;
        }

        $el.html(`<span class="bk">[</span>${text}<span class="bk">]</span>`);
    }

    let $themeToggleButton = $("a.toggle-dark-mode");
    updateThemeButton($themeToggleButton, getDisplayedTheme());

    $themeToggleButton.on("click", function() {
        cycleColorSchemes()
        updateThemeButton($(this), getDisplayedTheme());
    });
</script>

<style scoped>
    .nav-bar {
        display: contents;
    }

    .left {
        left: 0;
    }

    .right {
        right: 0;
    }

    :global(svg) {
        --col-svg: var(--col-text-1);

        width: 1em;
        height: 1em;

        /* Align with text baseline naturally */
        vertical-align: -0.125em;

        flex-shrink: 0;
    }

    .buttons {
        position: fixed;
        box-sizing: border-box;
        z-index: 2000;
        width: fit-content;

        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: flex-start;
        flex-wrap: wrap;

        color: var(--col-nav-link-text);
        border: 1px solid transparent;
        transition: border var(--theme-transition), color var(--theme-transition), background-color var(--theme-transition);

        font-size: 1.3em;
        letter-spacing: .03em;
        text-transform: uppercase;
        margin: .3rem;
        padding: .2rem .4rem;
        gap: 1rem;
        top: 0;

        a.link {
            all: unset;
            cursor: pointer;
            text-decoration: none;
            transition: color 150ms;

            .bk {
                color: var(--col-nav-link);
                transition: color 150ms;
            }

            &:hover {
                color: var(--col-nav-link-text);

                .bk {
                    color: var(--col-nav-link-hover);
                }
            }
        }
    }

    .is-scrolled,
    .floating {
        background-color: var(--col-nav-background);
        border: 1px solid var(--col-nav-border);
    }

    @media (max-width: 640px) {
        .nav-bar {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;

            position: fixed;
            inset: 0 0 auto 0;
            z-index: 10;
            box-sizing: border-box;

            background-color: var(--col-nav-background);
            border: none;
            border-bottom: 1px solid transparent;

            font-size: 0.95rem;
            letter-spacing: .03em;
            text-transform: uppercase;
            padding: .3rem .5rem;
            gap: .5rem;

            &.is-scrolled {
                border-bottom-color: var(--col-nav-border);
            }

            &[mobile-centered="true"] {
                justify-content: space-evenly;

                .buttons {
                    display: contents;
                }
            }
        }

        .buttons {
            position: static;
            width: auto;
            margin: 0;
            padding: 0;
            border: none;
            background: none;
            font-size: 1em;
            flex-wrap: nowrap;
            gap: .5rem;
        }
    }
</style>