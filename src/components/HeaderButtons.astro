---
import type {Button} from "../utils/types.ts";
const buttons: Button[] = [
    { alignRight: true, label: "</>", url: "https://github.com/phantomeye1931/phantomeye1931.github.io"},
    { alignRight: true, label: "sync",  url: "javascript:void(0)", behavior: "toggle-dark-mode"},
]

interface Props {
    extraButtons: Button[],
    mobileCentered?: boolean,
}
const props = Astro.props;
buttons.push( ...props.extraButtons );
---

<div class="nav-bar" mobile-centered={ props.mobileCentered ?? false }>
    <div class="buttons left">
        { buttons.filter(button => !button.alignRight).map((button) => (
                    <a href={button.url} class=`link font-mono ${button.behavior}` ><span class="bk">[</span>{button.label}<span class="bk">]</span></a>
        ))}
    </div>
    <div class="buttons right">
        { buttons.filter(button => button.alignRight).map((button) => (
                <a href={button.url} class=`link font-mono ${button.behavior}` ><span class="bk">[</span>{button.label}<span class="bk">]</span></a>
        ))}
    </div>
</div>

<script>
    const $buttonsDiv = $(".buttons, .nav-bar");

    window.addEventListener("scroll", () => {
        $buttonsDiv.toggleClass("is-scrolled", window.scrollY > 0);
    });

    // Function to update the label text
    function setModeLabel($el: JQuery, mode: any) {
        $el.html(`<span class="bk">[</span>${mode}<span class="bk">]</span>`);
    }

    const toggleLink = $("a.toggle-dark-mode");
    setModeLabel(toggleLink, (window as any).getColorScheme()); // Initial update

    toggleLink.on("click", function() {
        setModeLabel($(this), (window as any).cycleColorScheme());
    });
</script>

<style scoped>
    .nav-bar {
        display: contents;
    }

    .left {
        left: 0;
    }

    .right {
        right: 0;
    }

    .buttons {
        position: fixed;
        box-sizing: border-box;
        z-index: 2000;
        width: fit-content;

        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: flex-start;
        flex-wrap: wrap;

        color: var(--col-nav-link-text);
        background-color: var(--col-nav-background);
        border: 1px solid transparent;
        transition: border 150ms, color 150ms;

        font-size: 1.3em;
        letter-spacing: .03em;
        text-transform: uppercase;
        margin: .3rem;
        padding: .2rem .4rem;
        gap: 1rem;
        top: 0;

        a.link {
            all: unset;
            cursor: pointer;
            text-decoration: none;
            transition: color 150ms;

            .bk {
                color: var(--col-nav-link);
                transition: color 150ms;
            }

            &:hover {
                color: var(--col-nav-link-text);
                text-decoration: underline;

                .bk {
                    color: var(--col-nav-link-hover);
                }
            }
        }
    }

    .is-scrolled {
        border: 1px solid var(--col-nav-border);
    }

    @media (max-width: 640px) {
        .nav-bar {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;

            position: sticky;
            top: 0;
            z-index: 2000;
            box-sizing: border-box;

            color: var(--col-nav-link-text);
            background-color: var(--col-nav-background);
            border: none;
            border-bottom: 1px solid transparent;
            transition: border-color 150ms, color 150ms;

            font-size: 0.95rem;
            letter-spacing: .03em;
            text-transform: uppercase;
            padding: .3rem .5rem;
            gap: .5rem;

            &.is-scrolled {
                border-bottom-color: var(--col-nav-border);
            }

            /* combine left + right buttons into one flat row, evenly spaced */
            &[mobile-centered="true"] {
                justify-content: space-evenly;

                .buttons {
                    display: contents;
                }
            }
        }

        .buttons {
            position: static;
            width: auto;
            margin: 0;
            padding: 0;
            border: none;
            background: none;
            font-size: 1em; /* cancel the desktop 1.3em multiplier */
            flex-wrap: nowrap;
            gap: .5rem;
        }
    }
</style>