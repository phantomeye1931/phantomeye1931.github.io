---
import type {Button} from "../utils/types.ts";
const buttons: Button[] = [
    { alignRight: true, label: "</>", url: "https://github.com/phantomeye1931/phantomeye1931.github.io"},
    { alignRight: true, label: "sync",  url: "javascript:void(0)", behavior: "toggle-dark-mode"},
]

interface Props {
    extraButtons: Button[],
}
const props = Astro.props;
buttons.push( ...props.extraButtons );
---

<div class="buttons">
    {
        buttons.map((button) => (
            <a href={button.url} class=`link font-mono ${button.behavior}` ><span class="bk">[</span>{button.label}<span class="bk">]</span></a>
        ))
    }
</div>

<script>
    const $buttonsDiv = $(".buttons");

    window.addEventListener("scroll", () => {
        $buttonsDiv.toggleClass("is-scrolled", window.scrollY > 0);
    });

    // Function to update the label text
    function setModeLabel($el: JQuery, mode: any) {
        $el.html(`<span class="bk">[</span>${mode}<span class="bk">]</span>`);
    }

    const toggleLink = $("a.toggle-dark-mode");
    setModeLabel(toggleLink, (window as any).getColorScheme()); // Initial update

    toggleLink.on("click", function() {
        setModeLabel($(this), (window as any).cycleColorScheme());
    });
</script>

<style scoped>
    .buttons {
        position: fixed;
        box-sizing: border-box;
        z-index: 2000;
        width: fit-content;

        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        align-items: flex-start;
        flex-wrap: wrap;

        color: var(--col-text);
        background-color: var(--col-background);
        border: 1px solid transparent;
        transition: border 150ms, color 150ms;

        font-size: 1.3em;
        letter-spacing: .03em;
        text-transform: uppercase;
        margin: .3rem;
        padding: .2rem .4rem;
        gap: 1rem;
        top: 0;
        right: 0;

        a.link {
            all: unset;
            cursor: pointer;
            text-decoration: none;
            transition: color 150ms;

            .bk {
                color: var(--col-cmyk-magenta);
                transition: color 150ms;
            }

            &:hover {
                color: var(--col-text);
                text-decoration: underline;

                .bk {
                    color: var(--col-cmyk-yellow);
                }
            }
        }
    }

    .is-scrolled {
        border: 1px solid var(--col-text-3);
    }
</style>