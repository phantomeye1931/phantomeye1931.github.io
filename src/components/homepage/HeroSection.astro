---
const titleText = "ARMAND\nDE VRIES";
const titleChars = titleText.split('');
---

<script>
    $(function() {
        // Find all spans we just rendered
        const $chars = $(".name .char");

        function reveal(index: number) {
            if (index < $chars.length) {
                $chars.eq(index).css("visibility", "visible");

                // Random delay for the next one
                const delay = 50 + Math.random() * 150;
                setTimeout(() => reveal(++index), delay);
            }
        }

        reveal(0);
    });
</script>

<div class="hero">
    <div class="name">
        {
            titleChars.map((char: string) => (
                <span class="char" style="visibility: hidden">{char}</span>
            ))
        }
    </div>

    <div class="pronunciation">
        /'ɑɹ.mɑnt də ˈvris/
    </div>

    <div class="about">
        <div class="info-item">Computing Science Student</div>
        <div class="info-item">Code Enthusiast</div>
        <div class="info-item">Digital Artist</div>
    </div>

    <div class="colophon">
        <span class="dots">
            <span class="dot c"></span>
            <span class="dot m"></span>
            <span class="dot y"></span>
            <span class="dot k"></span>
        </span>
        <span class="label font-mono">Proof 01 &middot; 175 lpi</span>
    </div>
</div>

<style>
    .hero {
        position: relative;
        height: 100svh;
        width: 100%;

        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        gap: 2rem;

        padding: 1rem;
        box-sizing: border-box;

        pointer-events: none;

        & * {
            text-align: right;
            pointer-events: auto;
        }
    }

    .name {
        padding-inline: 1rem;
        margin-right: -1rem;

        //background-color: var(--col-background);

        color: var(--col-text);
        font-family: 'Fraunces', serif;
        position: relative;

        font-weight: 900;
        //font-size: clamp(2rem, 10vw, 7rem); /* TODO: what the fuck */
        line-height: 1;
        white-space: pre; /* allow \n line breaks */

        container-type: inline-size;

        width: 100%;
        max-width: 600px;

        & > span {
            position: relative;
            font-size: 19cqw;
            text-shadow: var(--text-shadow-cmyk);
        }
    }

    .pronunciation {
        padding-inline: 0.5rem;

        background-color: var(--col-background);

        color: var(--col-cmyk-magenta);
        font-family: 'Space Mono', monospace;
        font-size: 1.7rem;
    }

    .about {
        padding-inline: 0.75rem;

        background-color: var(--col-background);

        color: var(--col-text-2);
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-weight: 500;
        font-size: 1.5rem;
    }

    .colophon {
        position: absolute;
        left: 1rem;
        bottom: 1rem;

        display: flex;
        align-items: center;
        gap: 0.6em;

        background-color: var(--col-background);
        padding: 0.3rem 0.6rem;

        &, & * {
            text-align: left;
        }

        @media (max-width: 640px) {
            display: none;
        }
    }

    .colophon .dots {
        display: flex;
        gap: 4px;
    }

    .colophon .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .colophon .dot.c { background: var(--col-cmyk-cyan); }
    .colophon .dot.m { background: var(--col-cmyk-magenta); }
    .colophon .dot.y { background: var(--col-cmyk-yellow); }
    .colophon .dot.k { background: var(--col-text); }

    .colophon .label {
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        color: var(--col-text-3);
        text-transform: uppercase;
    }
</style>
