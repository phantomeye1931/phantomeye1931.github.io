---

import Spacing from "../simple/Spacing.astro";---

<link rel="stylesheet" href="https://githubgraph.jigyansurout.com/assets/css/gh.css">

<div class="center">
    <Spacing x="6em" />
    <div id="gh" data-login="phantomeye1931" data-show-thumbnail="false">
        <div class="loader"></div>
    </div>
</div>

<style>
    :global(#gh) {
        margin-inline: auto;
        /* the widget sizes cells, row height, *and* spacing off its own
           --gh-cell-* vars (see gh.css: `.ghCalendarTable tr { height: var(--gh-cell-size) }`,
           `border-spacing: var(--gh-cell-gap)`) — setting these instead of
           forcing width/height on the cells directly keeps rows/columns in
           sync with the bigger cell size instead of corrupting the grid */
        --gh-cell-size: 16px;
        --gh-cell-gap: 4px;
        --gh-cell-radius: 4px;

        & :global(.ghCalendarHeader) {
            padding-inline: 60px 25px;
            font-weight: bold;

            & :global(img) {
                display: none;
            }

            & :global(a::before) {
                content: "@";
            }
        }
    }

    @media (max-width: 800px) {
        :global(.center) {
            display: none;
        }
    }

    :global(#gh) {
        /* an actual color ramp (GitHub's own graph is green) instead of the
           ink-density grayscale — using --col-cmyk-green (cyan+yellow, a
           subtractive mix) rather than a generic web green keeps it tied to
           the site's own process-ink palette instead of a borrowed one */
        --gh-cell-level0-color: var(--col-background-2);
        --gh-cell-level1-color: color-mix(in srgb, var(--col-cmyk-green) 35%, var(--col-background));
        --gh-cell-level2-color: color-mix(in srgb, var(--col-cmyk-green) 65%, var(--col-background));
        --gh-cell-level3-color: var(--col-cmyk-green);
        --gh-cell-level4-color: color-mix(in srgb, var(--col-cmyk-green) 70%, var(--col-text));
    }

    .loader {
        width: 40px;
        height: 40px;
        border: 5px solid var(--gh-cell-level2-color);
        border-bottom-color: transparent;
        border-radius: 100vh;
        animation: rotation 1s linear infinite;
    }

    @keyframes rotation {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    #gh {
        /* Glacier Theme */
        --gh-bg-color: var(--col-background);
        --gh-text-default-color: var(--col-text-2);
        --gh-text-inactive-color: var(--col-text-2);
        --gh-link-hover-color: var(--col-text);

        --gh-border-card-color: rgba(0, 0, 0, 0);

        --gh-base-size-4: 0.25rem;
        --gh-base-size-8: 0.5rem;
        --gh-base-size-12: 0.75rem;
        --gh-base-size-16: 1rem;
        --gh-base-size-32: 2rem;

        /* the tooltip previously reused --gh-cell-level0-color (the pale
           "no contribution" tone) as its own background — a pale chip
           floating over a pale page is exactly why the text read as barely
           legible. A proper high-contrast chip: full ink in light mode,
           full paper in dark mode, with the text color inverted to match. */
        --gh-cell-info-bg-color: var(--col-text);
        --gh-tooltip-text-color: var(--col-background);
        --gh-cell-outline-color: rgba(0, 0, 0, 0);
        --gh-cell-border-color: rgba(0, 0, 0, 0);
        --gh-border-card-width: max(1px, 0.0625rem);
        --gh-font-default-family: "Roboto Slab", serif;
    }
</style>

<script src="https://githubgraph.jigyansurout.com/assets/js/gh.js"></script>