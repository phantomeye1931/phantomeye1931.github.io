---

import Spacing from "../simple/Spacing.astro";---

<link rel="stylesheet" href="https://githubgraph.jigyansurout.com/assets/css/gh.css">

<div class="center">
    <Spacing x="6em" />
    <div id="gh" data-login="phantomeye1931" data-show-thumbnail="false">
        <div class="loader"></div>
    </div>
</div>

<style>
    :global(#gh) {
        margin-inline: auto;

        --gh-cell-size: 16px;
        --gh-cell-gap: 4px;
        --gh-cell-radius: 4px;

        & :global(.ghCalendarHeader) {
            padding-inline: 60px 25px;
            font-weight: bold;

            & :global(img) {
                display: none;
            }

            & :global(a::before) {
                content: "@";
            }
        }
    }

    @media (max-width: 800px) {
        :global(.center) {
            display: none;
        }
    }

    :global(#gh) {
        --gh-cell-level0-color: var(--col-background-2);
        --gh-cell-level1-color: color-mix(in srgb, var(--col-cmyk-green) 35%, var(--col-background));
        --gh-cell-level2-color: color-mix(in srgb, var(--col-cmyk-green) 65%, var(--col-background));
        --gh-cell-level3-color: var(--col-cmyk-green);
        --gh-cell-level4-color: color-mix(in srgb, var(--col-cmyk-green) 80%, var(--col-text-1));
    }

    .loader {
        width: 40px;
        height: 40px;
        border: 5px solid var(--gh-cell-level2-color);
        border-bottom-color: transparent;
        border-radius: 100vh;
        animation: rotation 1s linear infinite;
    }

    @keyframes rotation {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    #gh {
        /* Glacier Theme */
        --gh-bg-color: var(--col-background);
        --gh-text-default-color: var(--col-text-2);
        --gh-text-inactive-color: var(--col-text-2);
        --gh-link-hover-color: var(--col-text-1);

        --gh-border-card-color: rgba(0, 0, 0, 0);

        --gh-base-size-4: 0.25rem;
        --gh-base-size-8: 0.5rem;
        --gh-base-size-12: 0.75rem;
        --gh-base-size-16: 1rem;
        --gh-base-size-32: 2rem;

        --gh-cell-info-bg-color: var(--col-text-1);
        --gh-tooltip-text-color: var(--col-background);
        --gh-cell-outline-color: rgba(0, 0, 0, 0);
        --gh-cell-border-color: rgba(0, 0, 0, 0);
        --gh-border-card-width: max(1px, 0.0625rem);
        --gh-font-default-family: "Roboto Slab", serif;
    }
</style>

<script src="https://githubgraph.jigyansurout.com/assets/js/gh.js"></script>