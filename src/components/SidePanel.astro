---
// A closable side panel for game/demo pages: sits beside the game inside a CenteredPage's row-wrap
// flex layout, closed (display: none) by default so the game stays centered on its own, and opens
// via `togglePanel('<id>')` / `openPanel('<id>')` - typically called from a button elsewhere on the
// page, since the thing that opens a panel usually isn't the panel itself. Extracted from
// tic-tac-tesseract's guide panel so every page gets the same open/close, scroll and mobile behavior.
interface Props {
    id: string;
    title: string;
    subtitle?: string;
    width?: string;
}

const { id, title, subtitle, width = "min(24rem, 90vw)" } = Astro.props;
---

<aside class="side-panel" id={id} style={`--panel-width: ${width}`}>
    <div class="panel-header">
        <div class="description">
            <h2 class="font-dotmatrix">{title}</h2>
            {subtitle && <span class="panel-subtitle">{subtitle}</span>}
        </div>

        <button type="button" class="panel-close" onclick={`closePanel('${id}')`} aria-label="Close panel">&times;</button>
    </div>

    <div class="panel-content">
        <slot />
    </div>
</aside>

<script>
    function togglePanel(id: string) {
        document.getElementById(id)?.classList.toggle('open');
    }

    function openPanel(id: string) {
        document.getElementById(id)?.classList.add('open');
    }

    function closePanel(id: string) {
        document.getElementById(id)?.classList.remove('open');
    }

    // Exposed globally: panels are opened by a button that lives outside this component (in the
    // consuming page), and the close button above is rendered via a plain onclick attribute,
    // which also runs outside this module's scope
    (window as any).togglePanel = togglePanel;
    (window as any).openPanel = openPanel;
    (window as any).closePanel = closePanel;
</script>

<style>
    .side-panel {
        display: none;
        flex-direction: column;
        /*align-self: flex-start;*/

        width: var(--panel-width);
        max-height: calc(100vh - 8rem);
        position: sticky;
        top: 2rem;

        background-color: var(--col-background);

        &.open {
            display: flex;
        }
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;

        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--col-border-2);

        & h2 {
            margin: 0;
            font-size: 1.1rem;
        }
    }

    .panel-subtitle {
        display: block;
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--col-text-2);
    }

    .panel-close {
        all: unset;
        cursor: pointer;
        font-size: 1.5rem;
        line-height: 1;
        padding: 0 0.25rem;
        color: var(--col-text-2);

        &:hover {
            opacity: 0.7;
        }
    }

    .panel-content {
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow-y: auto;
        padding: 1rem;

        scrollbar-color: var(--col-border-2) var(--col-background);

        &::-webkit-scrollbar {
            width: 10px;
        }

        &::-webkit-scrollbar-track {
            background: var(--col-background);
        }

        &::-webkit-scrollbar-thumb {
            background-color: var(--col-border-2);
        }

        &::-webkit-scrollbar-thumb:hover {
            background-color: var(--col-text-2);
        }
    }

    /* Mobile override kept last so it wins the cascade against same-specificity rules above */
    @media (max-width: 1120px) {
        .side-panel {
            position: fixed;
            inset: 0;
            width: 100%;
            max-height: none;
            z-index: 2001;
        }
    }
</style>
