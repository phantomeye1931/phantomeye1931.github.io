---
export enum Doodle {
    ARROW_CURLY_RIGHT = 'arrow-curly-right',
    ARROW_LEFT = 'arrow-left',
    ARROW_UP_LEFT = 'arrow-up-left',
    ARROW_DOWN_RIGHT = 'arrow-down-right',
    SMILEY = 'smiley',
}

interface Props {
    x?: number // px, moves the arrow from its inherited anchor point
    y?: number // px
    textX?: number // px, moves the label independently of the arrow
    textY?: number // px
    doodle: Doodle,
}

const { x = 0, y = 0, textX = 0, textY = 0, doodle } = Astro.props;
const { default: svgContent } = await import(`../../../public/svg/doodles/${doodle}.svg?raw`);
---

<div class="pointout" style={`translate: ${x}px ${y}px;`}>
    <div class="arrow" set:html={svgContent} />
    <span class="text" style={`translate: ${textX}px ${textY}px;`}><slot /></span>
</div>

<style>
    .pointout {
        --col-doodle: var(--col-text-2);

        position: absolute;
        inset: 0 auto auto 0;
        pointer-events: none;
    }

    .arrow {
        display: block;
        width: 7rem;

        & :global(svg) {

            display: block;
            width: 100%;
            height: auto;
        }
    }

    .text {
        position: absolute;
        top: 100%;
        left: 0;
        white-space: nowrap;

        font-family: "Caveat", sans-serif;
        font-size: 2.55rem;
        color: var(--col-doodle);
    }
</style>
