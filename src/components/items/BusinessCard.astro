<div id="container">
    <div id="flip-wrapper">
        <div id="tilt-card">
            <div class="face front">
                <div class="colophon">
                    <span class="dots">
                        <span class="dot c"></span>
                        <span class="dot m"></span>
                        <span class="dot y"></span>
                        <span class="dot k"></span>
                    </span>
                    <span class="label">armand.dev</span>
                </div>
                <div class="_name">Armand<br>de Vries</div>
                <div class="_tagline">Code Enthusiast &middot; Digital Artist</div>
            </div>
            <div class="face back">
                <div class="_name">Armand<br>de Vries</div>
                <div class="_website">armand.dev</div>
                <div class="colophon signature">
                    <span class="dots">
                        <span class="dot c"></span>
                        <span class="dot m"></span>
                        <span class="dot y"></span>
                        <span class="dot k"></span>
                    </span>
                    <span class="label">Proof 01 &middot; 175 lpi</span>
                </div>
                <div class="ink">
                    <div class="_details_top">
                        <div>armand.devries</div>
                        <div>@outlook.com</div>
                    </div>
                    <div class="_details_bottom"><span>+31 6 45154949</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #container {
        perspective: 1000px;
        width: 455px;
        height: 260px;

        @media (max-width: 1000px) {
            scale: .7;
        }
    }

    #flip-wrapper {
        width: 100%;
        height: 100%;
        transition: transform 0.3s;
        transform-style: preserve-3d;
        cursor: pointer;
    }

    #tilt-card {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;

        transition: transform 0.3s;
        transition-property: transform, scale;

        /* Fine, I'll make my own drop shadow */
        &::before {
            content: '';
            position: absolute;
            inset: -10px;
            background: rgba(0, 0, 0, 0.2);
            filter: blur(15px);

            z-index: -1;

            opacity: 0.5;
            transition: opacity 0.3s;
            pointer-events: none;

            translate: 0 20px;
        }

        #container:hover &::before {
            opacity: 1;
        }
    }

    .face {
        --padding: 1.6rem;

        position: absolute;
        transform-style: preserve-3d;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;

        background-color: var(--col-background);
        background-image: radial-gradient(circle, var(--col-text-3) 6%, transparent 6%);
        background-size: 13px 13px;
    }

    .front {
        overflow: hidden;
    }

    .back {
        transform: rotateY(180deg);
        overflow: hidden;
    }

    /* Card contents */
    .face {
        & > * {
            position: absolute;
            transform: translateZ(1px);

            font-family: 'Space Mono', monospace;
            font-weight: 500;
        }

        & ._name {
            left: var(--padding);
            top: 4.4rem;
            text-align: left;

            font-family: 'Fraunces', serif;
            font-weight: 800;
            font-size: 46px;
            line-height: 0.95;

            color: var(--col-text-1);
            text-shadow: var(--text-shadow-aberration);
        }

        & ._tagline {
            left: var(--padding);
            bottom: var(--padding);

            font-family: 'Fraunces', serif;
            font-style: italic;
            font-weight: 500;
            font-size: 0.85rem;
            color: var(--col-text-2);
        }
    }

    /* Colophon / brand mark, matching the hero's proof-mark motif */
    .colophon {
        left: var(--padding);
        top: var(--padding);

        display: flex;
        align-items: center;
        gap: 0.5rem;

        & .dots {
            display: flex;
            gap: 4px;
        }

        & .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }
        & .dot.c { background: var(--col-cmyk-cyan); }
        & .dot.m { background: var(--col-cmyk-magenta); }
        & .dot.y { background: var(--col-cmyk-yellow); }
        & .dot.k { background: var(--col-text-1); }

        & .label {
            font-size: 0.62rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--col-text-2);
        }
    }

    .colophon.signature {
        left: var(--padding);
        top: auto;
        bottom: var(--padding);

        & .label {
            color: var(--col-text-3);
        }
    }

    .back {
        & ._name {
            top: var(--padding);
            font-weight: 700;
            font-size: 30px;
            line-height: 1.02;
            max-width: 54%;
        }

        & ._website {
            left: var(--padding);
            top: calc(var(--padding) + 4.2rem);

            font-size: 0.68rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--col-text-2);
        }

        & .ink {
            position: absolute;
            inset: 0 0 0 auto;
            width: 70%;
            height: 100%;
            overflow: hidden;

            background-image: url("/business_card/back_gradient.webp");
            background-size: cover;
            background-position: right center;

            /* Fade the left edge instead of a hard cutoff */
            mask-image: linear-gradient(to right, transparent, black 28%);
            -webkit-mask-image: linear-gradient(to right, transparent, black 28%);

            :global(html[color-scheme='dark']) & {
                background-image: url("/business_card/back_gradient_dark.webp");
            }

            & > * {
                position: absolute;
                transform: translateZ(1px);

                font-family: 'Space Mono', monospace;
                font-weight: 700;

                background-color: var(--col-background);
                padding: 0.3rem 0.5rem;
            }
        }

        & ._details_top {
            text-align: right;
            color: var(--col-text-2);
            font-size: 0.72rem;
            line-height: 1.4;
            inset: calc(var(--padding) * 0.6) calc(var(--padding) * 0.6) auto auto;
        }

        & ._details_bottom {
            text-align: right;
            color: var(--col-accent);
            font-size: 0.85rem;
            letter-spacing: 0.03em;
            inset: auto calc(var(--padding) * 0.6) calc(var(--padding) * 0.6) auto;
        }
    }
</style>

<script is:inline>
    const container = document.getElementById('container');
    const flipWrapper = document.getElementById('flip-wrapper');
    const tiltCard = document.getElementById('tilt-card');

    let isFlipped = false;
    let hovering = false;

    const updateTilt = (e) => {
        if (!hovering) return;

        const { left, top, width, height } = container.getBoundingClientRect();
        const x = ((e.clientX - left) / width - 0.5) * 20;
        const y = ((e.clientY - top) / height - 0.5) * -20 * (isFlipped ? -1 : 1);

        tiltCard.style.transitionProperty = 'scale';
        // tiltCard.style.transform = `scale(1.05) rotateX(${y}deg) rotateY(${x}deg)`;
        tiltCard.style.scale = `1.05`;
        tiltCard.style.transform = `rotateX(${y}deg) rotateY(${x}deg)`;
    };

    container.onmousemove = updateTilt;

    container.onmouseenter = () => {
        hovering = true;
    }

    container.onmouseleave = (e) => {
        hovering = false;
        tiltCard.style.transitionProperty = 'transform, scale';
        tiltCard.style.scale = '';
        tiltCard.style.transform = '';
    };

    flipWrapper.onclick = (e) => {
        isFlipped = !isFlipped;
        flipWrapper.style.transform = isFlipped ? 'rotateY(180deg)' : '';

        updateTilt(e);
        tiltCard.style.transitionProperty = 'transform, scale';
    };
</script>