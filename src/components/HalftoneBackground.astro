---
import { BackgroundVariant } from "../utils/types.ts";

interface Props {
    sticky: boolean,
    variant?: BackgroundVariant,
}

export type BackgroundOpts = Props;

const props = Astro.props;

const variant = props.variant ?? BackgroundVariant.Fill;
---

<div class="halftone-wrapper" aria-hidden="true" sticky={ props.sticky } data-variant={variant}>
    <video class="halftone-video light" muted loop playsinline disableRemotePlayback></video>
    <video class="halftone-video dark"  muted loop playsinline disableRemotePlayback></video>
</div>

<!-- Hide the site until the halftone videos are loaded, for max 4 seconds -->
<div class="halftone-veil"></div>
<noscript><style>.halftone-veil { display: none !important; }</style></noscript>

<script is:inline>
    setTimeout(() => {
        $('.halftone-veil').addClass('is-hidden');
    }, 4000);
</script>

<script>
    const someMap = {
        Pending: "PENDING",
        Approved: "APPROVED",
        Rejected: "REJECTED",
    } as const;

    type Keys = keyof typeof someMap;

    function getACertainValue(key: Keys) {
        return someMap[key];
    }

    import { getDisplayedTheme, onThemeChange, Theme } from "../scripts/theme.ts";
    import { BackgroundVariant } from "../utils/types.ts";

    const $wrapper = $(".halftone-wrapper");
    const $video_light = $(".halftone-video.light");
    const $video_dark = $(".halftone-video.dark");

    const $veil = $(".halftone-veil");

    const desiredVariant = $wrapper.data().variant as BackgroundVariant;
    let currentVariant: BackgroundVariant | null = null;

    onThemeChange(() => applyTheme(currentVariant ?? BackgroundVariant.Fill));

    const MOBILE_QUERY = window.matchMedia('(max-width: 640px)');
    MOBILE_QUERY.addEventListener("change", updateVideos);

    let veiled = true;
    updateVideos();

    function updateVideos() {
        let newVariant = desiredVariant

        // Hero-band only overrides the video source below 640px. Above that it renders as a plain gradient
        const MOBILE_QUERY = window.matchMedia('(max-width: 640px)');
        if (MOBILE_QUERY.matches && currentVariant != BackgroundVariant.MobileGradient) {
            newVariant = BackgroundVariant.MobileGradient;
        }

        if (newVariant != currentVariant) {
            applyTheme(newVariant);
        }
    }

    function clearVeil() {
        $veil.addClass('is-hidden');
    }

    function sourcesFor(key: string): string {
        const base = `/backgrounds/${key}`;
        // AV1 first (~55% smaller, same quality); browser falls back to H.264 if it can't play it
        return `<source src="${base}.av1.mp4" type="video/mp4; codecs=av01.0.05M.08" />`
             + `<source src="${base}.mp4" type="video/mp4" />`;
    }

    function applyTheme(variant: BackgroundVariant) {
        const darkTheme = getDisplayedTheme() == Theme.DARK;
        let $active = darkTheme ? $video_dark : $video_light;
        let $standby = darkTheme ? $video_light: $video_dark;

        $active.addClass("shown");
        $standby.removeClass("shown");

        $video_light.html(sourcesFor(`light-${variant}`));
        $video_dark.html(sourcesFor(`dark-${variant}`));

        loadActive($active);
        deferLoad($standby, $active);

        currentVariant = variant;

        // Veil stuff
        if (veiled) {
            veiled = false;
            $active.on('error', clearVeil);
            $active.on('canplaythrough', clearVeil);

            const element = $active[0] as HTMLVideoElement;
            if (element.readyState >= 4) clearVeil();
        }
    }

    // Loads and plays the visible video immediately, full bandwidth to it
    function loadActive($video: JQuery) {
        const el = $video[0] as HTMLVideoElement | undefined;
        if (!el) return;
        el.preload = "auto";
        el.autoplay = true;
        el.load();
        el.play().catch(() => {});
    }

    // Holds off loading the hidden video until the active one is ready, so they don't split bandwidth
    function deferLoad($video: JQuery, $waitFor: JQuery) {
        const el = $video[0] as HTMLVideoElement | undefined;
        if (!el) return;
        el.autoplay = false;
        $waitFor.one("canplaythrough error", () => {
            el.preload = "auto";
            el.load();
        });
    }
</script>

<style>
.halftone-wrapper {
    position: fixed;
    inset: 0;
    width: 100%;
    min-height: 100dvh;
    overflow: hidden;
    background-color: var(--col-background);

    &[sticky="false"] {
        position: absolute;
        height: 100svh;
    }

    &[sticky="false"] {
        @media (max-width: 640px) {
            height: 60svh;
            min-height: 0;
        }
    }
}

.halftone-veil {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: var(--col-background);
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.35s ease;

    &.is-hidden {
        opacity: 0;
        pointer-events: none;
    }
}

video.halftone-video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;

    opacity: 0;
    transition: opacity var(--theme-transition);

    &.shown {
        opacity: 1;
    }
}
</style>
