---
interface Props {
    sticky: boolean,
    fill?: boolean,
    flip?: boolean,
}

const props = Astro.props;

// Every combination of theme (light/dark) x variant (gradient/fill) has been
// pre-rendered to video (see /public/backgrounds and pages/cmyk-halftone.astro,
// the recorder that produced them) — so this component no longer needs to
// render anything itself, just point a <video> at the right pre-baked file.
const variant = (props.fill ?? false) ? 'fill' : 'gradient';
---

<div class="bg-grid halftone-wrapper" aria-hidden="true" sticky={ props.sticky } flip={ props.flip ?? false } data-variant={variant}>
    <video class="halftone-video" muted loop playsinline preload="auto" disableRemotePlayback></video>
</div>

<script>
    const $wrapper = document.querySelector<HTMLDivElement>(".halftone-wrapper");
    const $video = document.querySelector<HTMLVideoElement>(".halftone-video");

    document.addEventListener('DOMContentLoaded', () => {
        if (!$wrapper || !$video) return;

        const variant = $wrapper.dataset.variant === 'fill' ? 'fill' : 'gradient';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function isDarkScheme(): boolean {
            return document.documentElement.getAttribute('color-scheme') === 'dark';
        }

        // webm listed first — smaller than the mp4 at equivalent quality for
        // this content (see the recorder's encode notes), so browsers that
        // support it (most, besides Safari) pick it over the mp4 fallback
        function applyTheme() {
            const theme = isDarkScheme() ? 'dark' : 'light';
            if ($video!.dataset.theme === theme) return; // avoid an unnecessary reload/restart
            $video!.dataset.theme = theme;

            const base = `/backgrounds/${theme}-${variant}`;
            $video!.innerHTML = `
                <source src="${base}.webm" type="video/webm" />
                <source src="${base}.mp4" type="video/mp4" />
            `;
            $video!.load();
            if (!reduceMotion) $video!.play().catch(() => {});
        }

        applyTheme();

        // the [sync] header button flips document.documentElement's
        // color-scheme attribute live — swap to the matching pre-rendered video
        new MutationObserver(applyTheme)
            .observe(document.documentElement, { attributes: true, attributeFilter: ['color-scheme'] });
    });
</script>

<style>
.bg-grid {
    position: fixed;
    inset: 0;
    width: 100%;
    min-height: 100dvh;
    overflow: hidden;
    background-color: var(--col-background);

    &[sticky="false"] {
        position: absolute;
        height: 100svh;
    }

    @media print {
        display: none !important;
    }
}

video.halftone-video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* the drift/warp/fade math has no inherent handedness — mirroring the
   pre-rendered video is a cheap way to reuse the exact same
   "concentrated + fading" look on the opposite side, rather than
   re-recording a mirrored pass */
.bg-grid[flip="true"] video.halftone-video {
    transform: scaleX(-1);
}
</style>
