---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<div class="gallery-header">
	<span class="header font-phont">{ text }</span>
	<span class="divider"></span>
</div>

<style>
	.gallery-header {
		display: flex;
		align-items: baseline;
		gap: 1em;
		margin-bottom: clamp(24px, 3.5vw, 36px);
	}

	.header {
		font-size: 2rem;
		letter-spacing: 0.1em;

		color: var(--pe-white-soft);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.divider {
		flex: 1;
		height: calc(2rem / 8);
		background: var(--pe-void-hair);
	}
</style>
