		description: "(Zelda)",
		sketchfabLink: "https://sketchfab.com/3d-models/master-sword-5a85fdbe4a894cba88d239f99b27a6d9",
		image: "/phantomeye/renders/master-sword.jpg",
		alt: "Low-poly pixelated Master Sword and Sheathe from The Legend of Zelda: Breath of the Wild",
	},
	{
		title: "The lamb",
		description: "(Cult of the Lamb)",
		sketchfabLink: "https://sketchfab.com/3d-models/the-lamb-cd476d5154924668963fae1fdee4a723",
		image: "/phantomeye/renders/cult-of-the-lamb.jpg",
		alt: "Low-poly pixelated Lamb from Cult of the Lamb flying, surrounded by rune symbols",
	},
	{
		title: "Magic Masks",
		description: "(Zelda)",
		image: "/phantomeye/renders/masks.png",
		alt: "Small pixelated model of Majora's Mask and a Korok Mask from The Legend of Zelda games",
	},
	{
		title: "' E '",
		description: "(The Entropy Centre)",
		sketchfabLink: "https://sketchfab.com/3d-models/e-the-entropy-centre-afe710d77a30432682269b8a96541094",
		image: "/phantomeye/renders/entropy-centre-e.jpg",
		alt: "Low-poly pixelated model of the robot character 'E' from The Entropy Centre",
	},
	{
		title: "Sony Walkman",
		image: "/phantomeye/renders/walkman.png",
		sketchfabLink: "https://sketchfab.com/3d-models/walkman-56bb0351e4e24ca3b045301c3fa2c310",
		alt: "Low-poly pixelated model of a blue 80s Sony Walkman with headphones",
	},
	{
		title: "Custom Pokemon",
		image: "/phantomeye/renders/some-pokemon.jpg",
		alt: "Low-poly pixelated model of a dragon-like creature on a white background",
	},
	{
		title: "Hornet",
		description: "(Hollow Knight)",
		image: "/phantomeye/renders/hornet.jpg",
		sketchfabLink: "https://sketchfab.com/3d-models/hornet-hollow-knight-5a83454b46da4d7e92fa4d0550386bdf",
		alt: "Low-poly pixelated model of Hornet from Hollow Knight spinning her needle to make circles of thread",
	},
	{
		title: "Stylised Skull",
		image: "/phantomeye/renders/stylised-skull.png",
		alt: "Low-poly pixelated model of a colorful purple skull",
	},
	{
		title: "Radiance",
		description: "(Hollow Knight)",
		image: "/phantomeye/renders/radiance.png",
		alt: "Low-poly pixelated model of The Radiance from Hollow Knight, shining bright on a dark background of void",
	},
	{
		title: "Nomai Mask",
		description: "(Outer Wilds)",
		image: "/phantomeye/renders/nomai-mask.png",
		alt: "Low-poly pixelated model of a Nomai Mask from Outer Wilds",
	},
	{
		title: "Skull Kid",
		description: "(Zelda)",
		image: "/phantomeye/renders/skull-kid.png",
		alt: "Low-poly pixelated model of Skull Kid from The Legend of Zelda: Ocarina of Time",
	},
	{
		title: "Minecraft Christmas Presents",
		image: "/phantomeye/renders/presents.png",
		alt: "Low-poly pixelated model of an Elevator from Portal 2",
	},
	{
		title: "1990s Car",
		image: "/phantomeye/renders/car.gif",
		sketchfabLink: "https://sketchfab.com/3d-models/90s-car-59fe840a12734416b8a2ba0c0bbf61e5",
		alt: "Low-poly pixelated model of an Elevator from Portal 2",
	},
	{
		title: "Aperture Elevator",
		description: "(Portal 2)",
		image: "/phantomeye/renders/elevator.png",
		alt: "Low-poly pixelated model of an Elevator from Portal 2",
	},
	{
		title: "Emotiguy",
		description: "(Posable)",
		sketchfabLink: "https://sketchfab.com/3d-models/emotiguy-df60dd01728f4a17868c7bc33db38782",
		image: "/phantomeye/renders/emotiguy.png",
		alt: "Low-poly pixelated model of an 'Emotiguy', an early-internet character of an emoji with floating shoes and hands",
	},
