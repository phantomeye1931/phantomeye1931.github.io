---

<section class="render-gallary" id="wall">
	<div class="render-gallary-wrapper">
		<GalleryHeader text="Low-poly Models" />

		<div class="render-grid">
			{
				pieces.reverse().map((piece, i) => (
					<figure class={`${piece.frameClass ?? ''} render-item`} data-sketchfab={piece.sketchfabLink}>
						<div class="image">
							<img src={ piece.image } alt={ piece.alt } loading="lazy" />
							{piece.image.toLowerCase().endsWith('.gif') && <canvas class="gif-freeze" />}
						</div>
						<figcaption>
							<span class="pe-cap-medium">3D Render</span>
							<span class="pe-cap-title">{ piece.title } <span class="description font-dotmatrix">{ piece.description }</span> </span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<div class="pe-lightbox">
	<div class="pe-lightbox-card">
		<div class="pe-lightbox-head">
			<span class="pe-cap-medium"></span>
			<button type="button" class="pe-lightbox-close" aria-label="Close">&times;</button>
		</div>

		<div class="pe-lightbox-image">
			<img alt="" />
		</div>

		<div class="pe-lightbox-foot">
			<span class="pe-lightbox-title">
				<span class="pe-lightbox-title-text"></span>
				<span class="description font-dotmatrix pe-lightbox-description"></span>
			</span>
			<a class="pe-lightbox-link" target="_blank" rel="noopener" hidden>View on Sketchfab &rarr;</a>
		</div>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLCanvasElement>(".gif-freeze").forEach((canvas) => {
		const img = canvas.previousElementSibling as HTMLImageElement | null;
		if (!img) return;

		const freeze = () => {
			canvas.width = img.naturalWidth;
			canvas.height = img.naturalHeight;
			canvas.getContext("2d")?.drawImage(img, 0, 0);
		};

		if (img.complete) freeze();
		else img.addEventListener("load", freeze, { once: true });
	});

	const overlay = document.querySelector<HTMLElement>(".overlay");
	const lightbox = document.querySelector<HTMLElement>(".pe-lightbox");
	// Move to <body> so its z-index compares directly against .overlay's instead of being
	// capped by the z-index:1 stacking context that .page-contents wraps this component in
	if (lightbox) document.body.appendChild(lightbox);
	const lightboxImg = lightbox?.querySelector<HTMLImageElement>(".pe-lightbox-image img");
	const lightboxMedium = lightbox?.querySelector(".pe-cap-medium");
	const lightboxTitle = lightbox?.querySelector(".pe-lightbox-title-text");
	const lightboxDescription = lightbox?.querySelector(".pe-lightbox-description");
	const lightboxLink = lightbox?.querySelector<HTMLAnchorElement>(".pe-lightbox-link");

	const openLightbox = (card: HTMLElement) => {
		const img = card.querySelector<HTMLImageElement>(".image img");
		if (lightboxImg && img) {
			lightboxImg.src = img.src;
			lightboxImg.alt = img.alt;
		}
		if (lightboxMedium) lightboxMedium.textContent = card.querySelector(".pe-cap-medium")?.textContent ?? "";
		if (lightboxTitle) lightboxTitle.textContent = card.querySelector(".pe-cap-title")?.childNodes[0]?.textContent?.trim() ?? "";
		if (lightboxDescription) lightboxDescription.textContent = card.querySelector(".description")?.textContent ?? "";

		const sketchfab = card.dataset.sketchfab;
		if (lightboxLink) {
			if (sketchfab) {
				lightboxLink.href = sketchfab;
				lightboxLink.hidden = false;
			} else {
				lightboxLink.hidden = true;
			}
		}

		lightbox?.classList.add("active");
		overlay?.setAttribute("active", "true");
		document.body.style.overflow = "hidden";
	};

	const closeLightbox = () => {
		lightbox?.classList.remove("active");
		overlay?.removeAttribute("active");
		document.body.style.overflow = "";
	};

	document.querySelectorAll<HTMLElement>(".render-item").forEach((card) => {
		card.addEventListener("click", () => openLightbox(card));
	});

	lightbox?.querySelector(".pe-lightbox-close")?.addEventListener("click", closeLightbox);
	lightbox?.addEventListener("click", (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") closeLightbox();
	});
</script>

<style>
	.render-gallary {
		background: var(--pe-void);
		padding: clamp(48px, 7vw, 84px) 0 clamp(56px, 8vw, 96px);
	}
	.render-gallary-wrapper {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 clamp(18px, 3.5vw, 48px);
	}
	.render-grid {
		--item-size: 300px;

		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(min(var(--item-size), 100%), 1fr));

		/*align-items: end;*/
	}

	.render-item {
		display: grid;
		grid-row: span 3; /* image / medium tag / title */
		grid-template-rows: subgrid;

		border: 1px solid var(--pe-void-hair);
		background: var(--pe-void-raised);
		padding: 8px 8px 0;
		margin: 0;
		transition: border-color 150ms;

		&:hover {
			cursor: pointer;
			border-color: var(--pe-blue-tint);
		}
	}

	.render-item .image {
		grid-row: 1;
		position: relative;
		overflow: hidden;
		background: var(--pe-void);
	}

	.render-item img {
		width: 100%;
		height: auto;
		display: block;

		/* Hover effect */
		/*transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);*/
	}

	.render-item:hover img {
		transform: scale(1.035);
	}

	.gif-freeze {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.render-item:hover .gif-freeze {
		opacity: 0;
	}

	figcaption {
		display: contents; /* lets .pe-cap-medium and .pe-cap-title sit directly in the subgrid, each on their own row */
	}

	.render-item .description {
		padding-left: 0.5em;
		font-size: 0.8em;
		color: var(--pe-white-soft);
	}

	.pe-cap-medium {
		grid-row: 2;
		color: var(--pe-muted-dim);
		padding: 0.75em 0.2em 0;

		font-size: 0.72rem;
		letter-spacing: 0.03em;
	}

	.pe-cap-title {
		grid-row: 3;
		font-family: var(--pe-font-display), serif;
		color: var(--pe-white);

		padding: 0.1em 0.2em 1em;
		font-weight: 600;
		font-size: 1.02rem;
	}

	/*@media (prefers-reduced-motion: reduce) {*/
	/*	.render-item img {*/
	/*		transition: none;*/
	/*	}*/
	/*}*/

	.pe-lightbox {
		position: fixed;
		inset: 0;
		z-index: 1001;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(16px, 4vw, 48px);

		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.pe-lightbox.active {
		opacity: 1;
		pointer-events: auto;
	}

	.pe-lightbox-card {
		display: flex;
		flex-direction: column;
		width: min(920px, 100%);
		max-height: 100%;

		border: 1px solid var(--pe-void-hair);
		background: var(--pe-void-raised);
		padding: 8px 8px 0;

		transform: scale(0.96);
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.pe-lightbox.active .pe-lightbox-card {
		transform: scale(1);
	}

	.pe-lightbox-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.2em 0.75em;
	}

	.pe-lightbox-head .pe-cap-medium {
		grid-row: auto;
		padding: 0;
	}

	.pe-lightbox-close {
		appearance: none;
		border: none;
		background: none;
		color: var(--pe-white-soft);
		font-size: 1.4rem;
		line-height: 1;
		padding: 0.2em;

		&:hover {
			cursor: pointer;
			color: var(--pe-white);
		}
	}

	.pe-lightbox-image {
		width: min(100%, 70vh);
		aspect-ratio: 1 / 1;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #000;
	}

	.pe-lightbox-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	.pe-lightbox-foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em 1em;
		padding: 1em 0.2em;
	}

	.pe-lightbox-title {
		font-family: var(--pe-font-display), serif;
		color: var(--pe-white);
		font-weight: 600;
		font-size: 1.02rem;
	}

	.pe-lightbox-link {
		white-space: nowrap;
		font-size: 0.85rem;
		color: var(--pe-white-soft);
	}

	.pe-lightbox-link:hover {
		color: var(--pe-blue-tint);
		cursor: pointer;
	}
</style>
