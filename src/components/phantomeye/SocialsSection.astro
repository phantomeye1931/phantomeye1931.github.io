const discord: Social = { label: "Discord", handle: "@phantomeye", url: "#" };

const socials: Social[] = [
	{ label: "GitHub", handle: "phantomeye1931", url: "https://github.com/phantomeye1931" },
	{ label: "Modrinth", handle: "PhantomEye", url: "https://modrinth.com/user/PhantomEye" },
	{ label: "Sketchfab", handle: "PhantomEye", url: "https://sketchfab.com/PhantomEye" },
];
---

<section class="socials-section" id="socials">
	<div class="socials-wrapper">
		<GalleryHeader text="Elsewhere" />

		<a class="social-card discord-card" href={ discord.url } target="_blank" rel="noopener">
			<span class="social-label">{ discord.label }</span>
			<span class="social-handle">
				<svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ ICONS[discord.label] } /></svg>
				{ discord.handle }
			</span>
			<span class="social-cta">Best way to reach me</span>
		</a>

		<div class="socials-grid">
			{ socials.map((social) => (
				<a class="social-card" href={ social.url } target="_blank" rel="noopener">
					<span class="social-label">{ social.label }</span>
					<span class="social-handle">
						<svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ ICONS[social.label] } /></svg>
						{ social.handle }
					</span>
					<span class="social-cta">Take a look</span>
				</a>
			)) }
		</div>
	</div>
</section>

<style>
	.socials-section {
		background: var(--pe-void);
		padding: clamp(48px, 7vw, 84px) 0 clamp(72px, 10vw, 120px);
	}
	.socials-wrapper {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 clamp(18px, 3.5vw, 48px);
	}

	.socials-grid {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.social-card {
		display: flex;
		flex-direction: column;
		gap: 0.4em;

		border: 1px solid var(--pe-void-hair);
		background: var(--pe-void-raised);
		padding: 1.4em 1.2em;

		transition: border-color 150ms;
	}

	.social-card:hover {
		border-color: var(--pe-blue-tint);
	}

	.social-label {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--pe-white-faint);
	}

	.social-handle {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;

		font-family: var(--pe-font-display), sans-serif;
		font-weight: 600;
		font-size: 1.2rem;
		color: var(--pe-white);
	}

	.social-icon {
		width: 0.85em;
		height: 0.85em;
		flex-shrink: 0;
	}

	.social-cta {
		margin-top: 0.4em;
		font-size: 0.8rem;
		color: var(--pe-white-soft);
	}

	.social-cta::after {
		content: "\2192";
		display: inline-block;
		margin-left: 0.4em;
		transition: transform 150ms;
	}

	.social-card:hover .social-cta {
		color: var(--pe-blue-tint);
	}

	.social-card:hover .social-cta::after {
		transform: translateX(0.2em);
	}

	.discord-card {
		background: var(--pe-blue-deeper);
		border-color: var(--pe-blue-tint);
		padding: 1.8em 1.6em;
	}

	.discord-card .social-handle {
		font-size: 1.7rem;
	}
</style>
