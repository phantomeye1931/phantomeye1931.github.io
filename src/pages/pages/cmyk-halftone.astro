---
import Page from "../../layouts/Page.astro";
---

<Page
    title={"CMYK Halftone Recorder"}
    description="Preview the CMYK halftone background effect, tweak its ink colors and blobs, and pre-render it frame-by-frame into a PNG/JPEG sequence for ffmpeg."
    opts={{ background: false, buttons: true }}
>
    <div class="recorder">
        <header class="intro">
            <h1>CMYK Halftone Recorder</h1>
            <p>
                The live halftone background redraws itself in real time, which stutters under
                load. This page instead renders each frame independently at its own fixed virtual
                timestamp and saves it as an image, since no frame has to keep up with a
                clock. The exported sequence has no dropped frames or lag spikes, no matter how
                slow the render actually runs. Unzip the result and hand it to ffmpeg to get a
                smooth video.
            </p>
            <p class="hint font-mono">
                <code>?gradient=true</code> / <code>?gradient=false</code> in the URL (or the
                checkbox below) toggles the right-edge fade.
            </p>
        </header>

        <div class="preview-canvas-wrap" aria-hidden="true">
            <canvas class="preview-canvas"></canvas>
        </div>

        <section class="channels-section">
            <h2>Ink channels</h2>
            <p class="hint">
                Each channel is one metaball "blob" cluster painted in one ink color. Drag a
                blob's slider to resize it, remove one with &times;, or add a new one. Changes
                show live in the preview above and carry over into the next recording.
            </p>
            <div class="channels-panel" id="channels-panel"></div>
        </section>

        <div class="controls-layout">
            <section class="panel">
                <div class="control checkbox-control">
                    <label for="gradient-toggle">
                        <input type="checkbox" id="gradient-toggle" checked />
                        Edge gradient fade
                    </label>
                </div>

                <div class="control">
                    <label for="out-width">Width (px)</label>
                    <input type="number" id="out-width" min="64" max="7680" step="1" value="1920" />
                </div>

                <div class="control">
                    <label for="out-height">Height (px)</label>
                    <input type="number" id="out-height" min="64" max="4320" step="1" value="1080" />
                </div>
            </section>

            <section class="panel">
                <div class="control">
                    <label for="out-fps">Frame rate (fps)</label>
                    <input type="number" id="out-fps" min="1" max="60" step="1" value="20" />
                </div>

                <div class="control">
                    <label for="out-duration">Duration (seconds)</label>
                    <input type="number" id="out-duration" min="0.1" max="120" step="0.5" value="6" />
                </div>

                <div class="control checkbox-control">
                    <label for="loop-toggle">
                        <input type="checkbox" id="loop-toggle" checked />
                        Seamless loop
                    </label>
                </div>
                <p class="loop-hint hint">
                    Snaps every blob's drift cycle to repeat a whole number of times over the
                    recorded duration, so the last frame flows straight back into the first.
                </p>

                <div class="control">
                    <label for="out-format">Frame format</label>
                    <select id="out-format">
                        <option value="png" selected>PNG (lossless, larger)</option>
                        <option value="jpeg">JPEG (smaller)</option>
                    </select>
                </div>

                <div class="control" id="quality-control" hidden>
                    <label for="out-quality">JPEG quality <span id="out-quality-val">0.92</span></label>
                    <input type="range" id="out-quality" min="0.5" max="1" step="0.01" value="0.92" />
                </div>

                <p class="hint" id="size-estimate"></p>
            </section>
        </div>

        <div class="action-row">
            <button type="button" id="record-btn" class="action-link font-mono">
                <span class="bk">[</span>RECORD FRAMES<span class="bk">]</span>
            </button>
            <button type="button" id="cancel-btn" class="action-link font-mono" hidden>
                <span class="bk">[</span>CANCEL<span class="bk">]</span>
            </button>

            <div class="progress" id="progress" hidden>
                <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
                <p class="progress-text" id="progress-text"></p>
            </div>
        </div>

        <div class="result" id="result" hidden>
            <p id="result-text"></p>
            <pre class="font-mono ffmpeg-cmd" id="ffmpeg-cmd"></pre>
        </div>
    </div>
</Page>

<script>
    import { BLOB_RADIUS_RANGE, createHalftoneEffect, DEFAULT_DRIFT_FPS, loopSafeBlobs, randomBlob, type Channel } from "../../utils/halftone";
    import { createZipWriter } from "../../utils/zip";

    const $previewWrap = document.querySelector<HTMLDivElement>(".preview-canvas-wrap")!;
    const $previewCanvas = document.querySelector<HTMLCanvasElement>(".preview-canvas")!;
    const $channelsPanel = document.getElementById("channels-panel") as HTMLDivElement;
    const $gradientToggle = document.getElementById("gradient-toggle") as HTMLInputElement;
    const $loopToggle = document.getElementById("loop-toggle") as HTMLInputElement;
    const $width = document.getElementById("out-width") as HTMLInputElement;
    const $height = document.getElementById("out-height") as HTMLInputElement;
    const $fps = document.getElementById("out-fps") as HTMLInputElement;
    const $duration = document.getElementById("out-duration") as HTMLInputElement;
    const $format = document.getElementById("out-format") as HTMLSelectElement;
    const $qualityControl = document.getElementById("quality-control") as HTMLDivElement;
    const $quality = document.getElementById("out-quality") as HTMLInputElement;
    const $qualityVal = document.getElementById("out-quality-val")!;
    const $recordBtn = document.getElementById("record-btn") as HTMLButtonElement;
    const $cancelBtn = document.getElementById("cancel-btn") as HTMLButtonElement;
    const $progress = document.getElementById("progress")!;
    const $progressFill = document.getElementById("progress-fill")!;
    const $progressText = document.getElementById("progress-text")!;
    const $result = document.getElementById("result")!;
    const $resultText = document.getElementById("result-text")!;
    const $ffmpegCmd = document.getElementById("ffmpeg-cmd")!;

    $fps.value = String(DEFAULT_DRIFT_FPS);

    function isDarkScheme(): boolean {
        return document.documentElement.getAttribute("color-scheme") === "dark";
    }

    // ---- URL <-> gradient toggle, so the page is linkable as described -------
    function gradientFromUrl(): boolean {
        const v = new URLSearchParams(window.location.search).get("gradient");
        return v === null ? true : v !== "false";
    }

    function setUrlGradient(gradient: boolean) {
        const url = new URL(window.location.href);
        url.searchParams.set("gradient", String(gradient));
        history.replaceState(null, "", url);
    }

    // ---- live preview (real-time, laggy if it lags, that's expected here) ----
    $gradientToggle.checked = gradientFromUrl();
    const previewEffect = createHalftoneEffect($previewCanvas, { fill: !$gradientToggle.checked });
    previewEffect.resolveColors();

    let previewRaf: number | null = null;
    let previewStart: number | null = null;

    function resizePreview() {
        const rect = $previewWrap.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        const scale = Math.min(window.devicePixelRatio || 1, 1);
        previewEffect.resize(Math.round(rect.width * scale), Math.round(rect.height * scale), scale);
    }

    function previewLoop(now: number) {
        previewRaf = requestAnimationFrame(previewLoop);
        if (previewStart === null) previewStart = now;
        previewEffect.drawFrame((now - previewStart) / 1000, isDarkScheme());
    }

    // pauses the free-running preview and snaps it to t=0, the exact state
    // frame 0 of a recording always starts from (recording already renders
    // i/fps from i=0, never wall-clock time, so the export was never actually
    // dependent on click timing). This just makes that visible. What you
    // watch during recording is the same t=0 starting point being captured,
    // not an unrelated animation drifting on its own real-time clock
    function resetPreviewToStart() {
        if (previewRaf !== null) { cancelAnimationFrame(previewRaf); previewRaf = null; }
        previewStart = null;
        previewEffect.drawFrame(0, isDarkScheme());
    }

    function resumePreview() {
        if (previewRaf !== null) return;
        previewStart = null;
        previewRaf = requestAnimationFrame(previewLoop);
    }

    resizePreview();
    resumePreview();

    // toggling fill only rebuilds the dot lattice. Channel colors/blobs the
    // user has already customized below are untouched
    $gradientToggle.addEventListener("change", () => {
        setUrlGradient($gradientToggle.checked);
        previewEffect.setFill(!$gradientToggle.checked);
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resizePreview, 150);
    });

    // ---- channel color / blob editor -----------------------------------------
    function renderBlobList(ch: Channel, $list: HTMLDivElement) {
        $list.innerHTML = "";

        if (ch.blobs.length === 0) {
            const $empty = document.createElement("p");
            $empty.className = "blob-empty";
            $empty.textContent = "No blobs. This ink stays blank.";
            $list.appendChild($empty);
        }

        ch.blobs.forEach((b, i) => {
            const $row = document.createElement("div");
            $row.className = "blob-row";

            const $tag = document.createElement("span");
            $tag.className = "blob-tag font-mono";
            $tag.textContent = `#${i + 1}`;

            const $slider = document.createElement("input");
            $slider.type = "range";
            $slider.min = String(BLOB_RADIUS_RANGE.min);
            $slider.max = String(BLOB_RADIUS_RANGE.max);
            $slider.step = "0.01";
            $slider.value = String(b.r);
            $slider.setAttribute("aria-label", `Blob ${i + 1} size`);
            $slider.addEventListener("input", () => {
                b.r = Number($slider.value);
            });

            const $removeBtn = document.createElement("button");
            $removeBtn.type = "button";
            $removeBtn.className = "blob-remove";
            $removeBtn.textContent = "×";
            $removeBtn.setAttribute("aria-label", `Remove blob ${i + 1}`);
            $removeBtn.addEventListener("click", () => {
                ch.blobs.splice(i, 1);
                renderBlobList(ch, $list);
            });

            $row.append($tag, $slider, $removeBtn);
            $list.appendChild($row);
        });
    }

    function renderChannelCard(ch: Channel): HTMLElement {
        const $card = document.createElement("section");
        $card.className = "panel channel-card";

        const $header = document.createElement("div");
        $header.className = "channel-header";

        const $label = document.createElement("span");
        $label.className = "channel-label";
        $label.textContent = ch.label;

        const $colorInput = document.createElement("input");
        $colorInput.type = "color";
        $colorInput.value = /^#[0-9a-f]{6}$/i.test(ch.resolved) ? ch.resolved : "#000000";
        $colorInput.setAttribute("aria-label", `${ch.label} ink color`);
        $colorInput.addEventListener("input", () => {
            previewEffect.setChannelColor(ch.id, $colorInput.value);
        });

        const $resetBtn = document.createElement("button");
        $resetBtn.type = "button";
        $resetBtn.className = "reset-color";
        $resetBtn.textContent = "reset";
        $resetBtn.addEventListener("click", () => {
            previewEffect.setChannelColor(ch.id, null);
            $colorInput.value = /^#[0-9a-f]{6}$/i.test(ch.resolved) ? ch.resolved : "#000000";
        });

        $header.append($label, $colorInput, $resetBtn);

        const $list = document.createElement("div");
        $list.className = "blob-list";
        renderBlobList(ch, $list);

        const $addBtn = document.createElement("button");
        $addBtn.type = "button";
        $addBtn.className = "add-blob";
        $addBtn.textContent = "+ add blob";
        $addBtn.addEventListener("click", () => {
            ch.blobs.push(randomBlob());
            renderBlobList(ch, $list);
        });

        $card.append($header, $list, $addBtn);
        return $card;
    }

    function renderChannels() {
        $channelsPanel.innerHTML = "";
        previewEffect.channels.forEach((ch) => {
            $channelsPanel.appendChild(renderChannelCard(ch));
        });
    }

    renderChannels();

    // the [sync] header button flips document.documentElement's color-scheme
    // attribute live. Re-resolve ink colors (var(--col-text) changes) and
    // rebuild the color pickers so non-overridden swatches reflect the new theme
    new MutationObserver(() => {
        previewEffect.resolveColors();
        renderChannels();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["color-scheme"] });

    // ---- format control --------------------------------------------------------
    $format.addEventListener("change", () => {
        $qualityControl.hidden = $format.value !== "jpeg";
        updateSizeEstimate();
    });
    $quality.addEventListener("input", () => {
        $qualityVal.textContent = Number($quality.value).toFixed(2);
        updateSizeEstimate();
    });

    // ---- rough size estimate, so a runaway width/height/duration/fps combo is
    // visible before you commit to it rather than after a long silent wait.
    // The per-pixel byte rate is calibrated off an actual recorded halftone
    // frame: the dot pattern is high-frequency noise that compresses far worse
    // than typical photo/UI content, so PNG in particular runs large
    const $sizeEstimate = document.getElementById("size-estimate")!;

    function updateSizeEstimate() {
        const width = clampInt($width.value, 64, 7680, 1920);
        const height = clampInt($height.value, 64, 4320, 1080);
        const fps = clampInt($fps.value, 1, 60, DEFAULT_DRIFT_FPS);
        const duration = clampFloat($duration.value, 0.1, 120, 6);
        const totalFrames = Math.max(1, Math.round(duration * fps));
        const megapixels = (width * height) / 1_000_000;

        const format = $format.value === "jpeg" ? "jpeg" : "png";
        const quality = Number($quality.value);
        const bytesPerPixel = format === "jpeg" ? 0.15 + quality * 0.5 : 1.6;
        const estBytes = megapixels * 1_000_000 * bytesPerPixel * totalFrames;

        $sizeEstimate.textContent = `≈ ${totalFrames} frames, ~${formatBytes(estBytes)} zipped (rough estimate).`;
    }

    [$width, $height, $fps, $duration].forEach((el) => {
        el.addEventListener("input", updateSizeEstimate);
    });
    updateSizeEstimate();

    // ---- recording ---------------------------------------------------------------
    let recording = false;
    let cancelRequested = false;

    function clampInt(value: string, min: number, max: number, fallback: number): number {
        const n = Math.round(Number(value));
        return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
    }

    function clampFloat(value: string, min: number, max: number, fallback: number): number {
        const n = Number(value);
        return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
    }

    function formatBytes(bytes: number): string {
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    // "20.00" -> "20", "6.50" -> "6.5". Keeps the filename tag short for the
    // (common) whole-second case without losing precision for fractional ones
    function formatDurationTag(seconds: number): string {
        return `${seconds.toFixed(2).replace(/\.?0+$/, "")}s`;
    }

    function setControlsDisabled(disabled: boolean) {
        for (const el of [$gradientToggle, $loopToggle, $width, $height, $fps, $duration, $format, $quality]) {
            (el as HTMLInputElement).disabled = disabled;
        }
    }

    function downloadBlob(blob: Blob, filename: string) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
    }

    async function startRecording() {
        if (recording) return;
        recording = true;
        cancelRequested = false;

        const width = clampInt($width.value, 64, 7680, 1920);
        const height = clampInt($height.value, 64, 4320, 1080);
        const fps = clampInt($fps.value, 1, 60, DEFAULT_DRIFT_FPS);
        const duration = clampFloat($duration.value, 0.1, 120, 6);
        const gradient = $gradientToggle.checked;
        const loopMode = $loopToggle.checked;
        const format = $format.value === "jpeg" ? "jpeg" : "png";
        const quality = Number($quality.value);
        const mimeType = format === "jpeg" ? "image/jpeg" : "image/png";
        const ext = format === "jpeg" ? "jpg" : "png";

        const totalFrames = Math.max(1, Math.round(duration * fps));
        // the actual span the recording covers once rounded to whole frames.
        // Loop quantization has to target this, not the raw input, or the last
        // exported frame (at t = (totalFrames-1)/fps) won't sit exactly one
        // frame short of a full cycle
        const effectiveDuration = totalFrames / fps;
        const pad = String(totalFrames - 1).length;

        // freeze the live preview at its t=0 state right away. Purely a visual
        // cue (see resetPreviewToStart's comment), the actual export below was
        // already deterministic regardless of when this button was clicked
        resetPreviewToStart();

        setControlsDisabled(true);
        $recordBtn.hidden = true;
        $cancelBtn.hidden = false;
        $result.hidden = true;
        $progress.hidden = false;
        $progressFill.style.width = "0%";
        $progressText.textContent = `Rendering frame 0 / ${totalFrames}…`;

        // a fresh, off-DOM canvas at the exact requested output resolution,
        // entirely decoupled from the live preview canvas above, seeded with
        // the same ink colors and blobs the user has been editing there
        const offCanvas = document.createElement("canvas");
        const effect = createHalftoneEffect(offCanvas, { fill: !gradient });
        effect.resolveColors();
        previewEffect.channels.forEach((srcCh) => {
            const destCh = effect.channels.find((c) => c.id === srcCh.id);
            if (!destCh) return;
            destCh.blobs = loopMode
                ? loopSafeBlobs(srcCh.blobs, effectiveDuration)
                : srcCh.blobs.map((b) => ({ ...b }));
            if (srcCh.colorOverride) effect.setChannelColor(srcCh.id, srcCh.colorOverride);
        });
        effect.resize(width, height, 1);
        const isDark = isDarkScheme();

        // built incrementally below. Each addEntry() call does that frame's
        // CRC32 + header work immediately, spread across the loop's existing
        // yield points, so there's no separate "zip everything" pass left at
        // the end to block on (a halftone frame's dot pattern is high-frequency
        // noise that PNG barely compresses, so real recordings run several MB
        // per frame, and checksumming all of them in one uninterrupted burst at
        // the end used to look, and functionally be, hung)
        const zipWriter = createZipWriter();
        let frameCount = 0;
        let totalBytes = 0;

        for (let i = 0; i < totalFrames; i++) {
            if (cancelRequested) break;

            // t is derived purely from the frame index and the target fps, never
            // from wall-clock time. That's the whole point: every frame gets
            // rendered as if it were on time, however long it actually takes
            effect.drawFrame(i / fps, isDark);

            const blob = await new Promise<Blob | null>((resolve) => {
                offCanvas.toBlob(resolve, mimeType, format === "jpeg" ? quality : undefined);
            });
            if (!blob) break;

            const bytes = new Uint8Array(await blob.arrayBuffer());
            totalBytes += bytes.length;
            zipWriter.addEntry(`frame_${String(i).padStart(pad, "0")}.${ext}`, bytes);
            frameCount++;

            $progressFill.style.width = `${((i + 1) / totalFrames) * 100}%`;
            $progressText.textContent = `Rendering frame ${i + 1} / ${totalFrames}, ${formatBytes(totalBytes)} so far`;

            // yield back to the browser periodically so the tab stays responsive
            // and the progress bar actually gets a chance to paint
            if (i % 3 === 0) await new Promise((r) => setTimeout(r, 0));
        }

        setControlsDisabled(false);
        $recordBtn.hidden = false;
        $cancelBtn.hidden = true;
        recording = false;

        if (cancelRequested || frameCount === 0) {
            $progress.hidden = true;
            resumePreview();
            return;
        }

        $progressText.textContent = "Finishing archive…";
        await new Promise((r) => setTimeout(r, 0));
        const zipBlob = zipWriter.finish();

        const stamp = new Date().toISOString().replace(/[:.]/g, "-");
        const themeTag = isDark ? "dark" : "light";
        const gradientTag = gradient ? "gradient" : "fill";
        const filename = `cmyk-halftone-frames-${themeTag}-${gradientTag}-${fps}fps-${formatDurationTag(effectiveDuration)}-${stamp}.zip`;
        downloadBlob(zipBlob, filename);

        // explicit confirmation that the zip actually finished AND the browser
        // download was handed off. Otherwise the status silently jumps from
        // "Finishing archive…" straight to the result panel with no visible
        // acknowledgement that the download itself was triggered
        $progressFill.style.width = "100%";
        $progressText.textContent = `Done, downloading ${filename}`;
        await new Promise((r) => setTimeout(r, 500));
        $progress.hidden = true;

        $result.hidden = false;
        const loopNote = loopMode ? ` Loop-safe: frame ${totalFrames} would land back on frame 1, so just repeat the clip, no crossfade needed.` : "";
        $resultText.textContent = `Downloaded ${filename}. ${frameCount} frame${frameCount === 1 ? "" : "s"} (${formatBytes(totalBytes)} zipped) at ${width}×${height}, ${effectiveDuration.toFixed(2)}s.${loopNote} Unzip, then run:`;
        $ffmpegCmd.textContent = `ffmpeg -framerate ${fps} -i frame_%0${pad}d.${ext} -c:v libx264 -pix_fmt yuv420p -movflags +faststart cmyk-halftone.mp4`;

        resumePreview();
    }

    $recordBtn.addEventListener("click", () => { void startRecording(); });
    $cancelBtn.addEventListener("click", () => { cancelRequested = true; });
</script>

<style is:global>
    /*
     * Global, not scoped: the channel cards, blob-list rows, color pickers,
     * and add/remove buttons are all built client-side via
     * document.createElement (see the <script> above), so they never receive
     * Astro's scoping attribute and scoped selectors would silently fail to
     * match them, same reasoning as pixel-palette.astro's swatch rows.
     */
    .recorder {
        max-width: 900px;
        width: 100%;
        margin-inline: auto;
        padding: 4rem var(--page-padding);
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .intro h1 {
        margin-bottom: 0.5rem;
    }

    .intro p {
        color: var(--col-text-2);
        line-height: 1.5;
        max-width: 65ch;
    }

    h2 {
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }

    .hint {
        color: var(--col-text-3);
        font-size: 0.85rem;
        max-width: 65ch;
    }

    .hint code {
        color: var(--col-text-2);
    }

    .preview-canvas-wrap {
        position: relative;
        width: 100%;
        height: min(60vh, 420px);
        border: 1px solid var(--col-divider);
        overflow: hidden;
        background-color: var(--col-background);
    }

    .preview-canvas {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .channels-panel {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .channel-card {
        display: flex;
        flex-direction: column;
    }

    .channel-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
    }

    .channel-label {
        flex: 1;
        font-size: 0.9rem;
        color: var(--col-text);
    }

    input[type="color"] {
        width: 1.8rem;
        height: 1.8rem;
        padding: 0;
        border: 1px solid var(--col-divider);
        background: none;
        cursor: pointer;
        flex-shrink: 0;
    }

    .reset-color {
        all: unset;
        cursor: pointer;
        font-size: 0.75rem;
        color: var(--col-text-3);
        text-decoration: underline;
        flex-shrink: 0;
    }

    .reset-color:hover {
        color: var(--col-text);
    }

    .blob-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 1.5rem;
    }

    .blob-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .blob-tag {
        font-size: 0.75rem;
        color: var(--col-text-3);
        width: 1.8rem;
        flex-shrink: 0;
    }

    .blob-row input[type="range"] {
        flex: 1;
    }

    .blob-remove {
        all: unset;
        cursor: pointer;
        color: var(--col-text-3);
        font-size: 1.1rem;
        line-height: 1;
        padding: 0 0.25rem;
        flex-shrink: 0;
    }

    .blob-remove:hover {
        color: var(--col-cmyk-magenta);
    }

    .blob-empty {
        font-size: 0.8rem;
        color: var(--col-text-3);
        margin: 0;
    }

    .add-blob {
        all: unset;
        cursor: pointer;
        font-size: 0.8rem;
        color: var(--col-element);
        margin-top: 0.75rem;
    }

    .add-blob:hover {
        text-decoration: underline;
    }

    .controls-layout {
        display: flex;
        flex-wrap: wrap;
