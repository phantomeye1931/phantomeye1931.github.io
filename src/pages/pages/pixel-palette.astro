        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
    }

    /* Fixed size so every slot (real or filler) lines up exactly */
    .swatch-square {
        all: unset;
        position: relative;
        display: flex;
        align-items: center;
