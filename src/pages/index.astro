---
import Page from "../layouts/Page.astro";
import HeroSection from "../components/homepage/HeroSection.astro";
import IntroSection from "../components/homepage/IntroSection.astro";
import ProjectsSection from "../components/homepage/ProjectsSection.astro";
import WeblogSection from "../components/homepage/WeblogSection.astro";
import Spacing from "../components/simple/Spacing.astro";

import {SITE_DESCRIPTION, SITE_TITLE} from "../consts.ts";
import ContactSection from "../components/homepage/ContactSection.astro";
import GitSection from "../components/homepage/GitSection.astro";
import type {Button} from "../utils/types.ts";
import { BackgroundVariant } from "../utils/types.ts";

const headerButtons: Button[] = [
	{ alignRight: true, label: "WEBLOG", url: "/#weblog"},
	{ alignRight: true, label: "PROJECTS",  url: "/#projects"},
	{ alignRight: true, label: "ART",  url: "/#art"},
];
---
<Page title={SITE_TITLE}
	  description={SITE_DESCRIPTION}
	  background={{ sticky: false, variant: BackgroundVariant.Gradient }}
	  navButtons={{ extraButtons: headerButtons, mobileCentered: true, dockingButtons: true }} >
	<HeroSection />

	<div class="parts">
		<IntroSection />
		<GitSection />
		<Spacing x="4em" />
		<ProjectsSection />
		<Spacing x="4em" />
		<WeblogSection />
		<ContactSection />
	</div>
</Page>

<style>
::-webkit-scrollbar {
	display: none;
}

html {
	font-family: 'Roboto Slab', sans-serif;

	-ms-overflow-style: none;
    scrollbar-width: none;
}

:global(.section) {
	color: var(--col-text-2);
	font-size: 1.2rem;
	line-height: 1.6;

	& :global(.title) {
		font-family: 'Fraunces', serif;
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--col-text-1);
		text-shadow: var(--text-shadow-aberration);

		margin-bottom: 1rem;
	}
}

.parts {
	padding: var(--page-padding);
	overflow-x: hidden;
}
</style>