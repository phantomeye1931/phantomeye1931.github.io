---
// PhantomEye (Armand's art brand) as an isolated route on armand.dev.
//
// Currently hosted at armand.dev/phantomeye; intended to move behind phantomeye.art
// once that domain is routed here (GitHub Pages hosting is a temporary arrangement).
import HeroSection from "../components/phantomeye/HeroSection.astro";
import IntroSection from "../components/phantomeye/IntroSection.astro";
import WallSection from "../components/phantomeye/WallSection.astro";
import MinecraftSkinSection from "../components/phantomeye/MinecraftSkinSection.astro";
import SpriteSection from "../components/phantomeye/SpriteSection.astro";
import SocialsSection from "../components/phantomeye/SocialsSection.astro";
import Page from "../layouts/Page.astro";
import type {Button} from "../utils/types.ts";

const title = "PhantomEye";
const description = "PhantomEye — low-poly 3D renders and pixel work.";

const headerButtons: Button[] = [
	{ alignRight: true, label: "MODELS", url: "#wall"},
	{ alignRight: true, label: "SKINS",  url: "#skins"},
	{ alignRight: true, label: "SPRITES",  url: "#sprites"},
	{ alignRight: true, label: "SOCIALS",  url: "#socials"},
	{ alignRight: true, label: "CODING",  url: "https://armand.dev/"},
];
---

<Page title={ title } description={ description } opts={{ background: false, buttons: true, noTheme: true, mobileCentered: true, extraButtons: headerButtons, defaultButtons: false }} >
	<HeroSection />
	<IntroSection />
	<WallSection />
	<MinecraftSkinSection />
	<SpriteSection />
	<SocialsSection />
</Page>

<style is:global>
	/* Self-hosted fonts for this page only. */
	@font-face {
		font-family: "Unbounded";
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url("/fonts/Unbounded-SemiBold.woff2") format("woff2");
	}
	@font-face {
		font-family: "Unbounded";
		font-style: normal;
		font-weight: 700;
		font-display: swap;
		src: url("/fonts/Unbounded-Bold.woff2") format("woff2");
	}
	@font-face {
		font-family: "Atkinson Hyperlegible";
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url("/fonts/atkinson-regular.woff") format("woff");
	}
	@font-face {
		font-family: "Atkinson Hyperlegible";
		font-style: normal;
		font-weight: 700;
		font-display: swap;
		src: url("/fonts/atkinson-bold.woff") format("woff");
	}

	body {
		--pe-blue: #5e71b9;
		--pe-blue-deep: #48588f;
		--pe-blue-deeper: #384570;
		--pe-blue-tint: #8f9dd4;

		--pe-white: #ffffff;
		--pe-white-soft: rgba(255, 255, 255, 0.74);
		--pe-white-faint: rgba(255, 255, 255, 0.42);

		--pe-void: #12131f;
		--pe-void-raised: #1b1d30;
		--pe-void-hair: rgba(255, 255, 255, 0.09);
		--pe-muted: #9791a8;
		--pe-muted-dim: #6d6980;

		--pe-font-display: "Unbounded", "Arial Black", ui-sans-serif, sans-serif;
		--pe-font-body: "Atkinson Hyperlegible", ui-sans-serif, system-ui, sans-serif;

		--col-background:      var(--pe-void);
		--col-nav-background:  var(--pe-blue);
		--col-nav-border:      var(--pe-blue-tint);
		--col-nav-link:        var(--pe-white);
		--col-nav-link-hover:  var(--pe-white-faint);
		--col-nav-link-text:   var(--pe-white);

		margin: 0;
		padding: 0;
		background: var(--pe-void);
		font-family: var(--pe-font-body), sans-serif;

		color: var(--pe-white);
		-webkit-font-smoothing: antialiased;
	}
	/* Nav background tracks whatever's actually behind it (hero blue, then the void
	   below) instead of going transparent, so it still reads as "see-through" without
	   fighting the busier backgrounds further down the page. Border switches to the
	   same hairline color the cards below use. Both toggled by the scroll listener
	   in this page's script below. */
	body.pe-past-hero {
		--col-nav-background: var(--pe-void);
		--col-nav-border: var(--pe-void-hair);
	}
	html {
		margin: 0;
	}
	body *,
	body *::before,
	body *::after {
		box-sizing: border-box;
	}
	body img {
		max-width: 100%;
		display: block;
	}
	body a {
		color: inherit;
		text-decoration: none;
	}
</style>

<script>
	// Flips the nav's background var (see body.pe-past-hero above) from hero blue to
	// void dark once the page has scrolled a full viewport height, so it keeps tracking
	// whatever's actually behind it instead of just going transparent.
	const NAV_SWITCH_AT = () => window.innerHeight;

	const update = () => {
		document.body.classList.toggle("pe-past-hero", window.scrollY > NAV_SWITCH_AT());
	};
	update();
	window.addEventListener("scroll", update, { passive: true });
</script>
